---
import Anchor from './common/Anchor.astro'

export type Props = {
    title: string
    description: string
    url: string
    githubUrl?: string
    liveUrl?: string
    tags: string[]
}

const { title, description, url, githubUrl, liveUrl, tags } = Astro.props
---

<div class="hover-zag-dotted-grid relative mb-12 flex flex-col gap-1">
    <div class="flex flex-col gap-3 sm:flex-row sm:justify-between">
        <Anchor url={url} class="text-xl">
            {title}
        </Anchor>
        <div class="flex gap-2">
            {
                githubUrl ? (
                    <Anchor url={githubUrl} class="text-sm" external>
                        GitHub
                    </Anchor>
                ) : null
            }
            {
                liveUrl ? (
                    <Anchor url={liveUrl} class="text-sm" external>
                        Live
                    </Anchor>
                ) : null
            }
        </div>
    </div>
    <p class="italic">
        {description}
    </p>
    <div class="flex flex-row flex-wrap gap-2">
        {
            tags.map((tag) => (
                <span class="-zag-text -zag-bg zag-transition px-2 py-1 text-sm font-semibold">
                    {tag}
                </span>
            ))
        }
    </div>
</div>
