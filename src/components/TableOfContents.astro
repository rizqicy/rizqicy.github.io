---
import type { MarkdownHeading } from 'astro'

type Props = {
    headings: MarkdownHeading[]
}

const { headings } = Astro.props
const filteredHeadings = headings.filter((heading) => heading.depth <= 2)
---

<nav class="sticky top-18 order-1 self-start p-4 max-lg:hidden">
    <div class="zag-bg zag-border-l">
        <h2 class="mx-4 font-bold">Table of Contents</h2>
        <ul class="mx-8">
            {
                filteredHeadings.map((heading) => (
                    <li class="hover:text-blue-600">
                        <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>
