---
import SocialMedia from '../SocialMedia.astro'
import { getConfigurationCollection } from '../../lib/utils'

const { data: config } = await getConfigurationCollection()
---

<div class="flex flex-col items-center gap-8 sm:flex-row">
    <div class="flex flex-col">
        <img
            src={config.hero.image}
            alt={`${config.hero.title}`}
            class="z-0 mb-4 h-40 w-40 max-w-40 grayscale"
        />
        <SocialMedia />
    </div>
    <div>
        <h1
            class="font-display opsz pb-2 text-center text-3xl font-semibold sm:text-left sm:text-4xl"
        >
            {config.hero.title}
        </h1>
        <h2
            class="pb-4 text-center font-sans text-lg font-medium sm:text-left sm:text-xl"
        >
            <p set:html={config.hero.subtitle} />
        </h2>
        <p class="text-center sm:text-left">{config.hero.description}</p>
    </div>
</div>
