---
import { getConfigurationCollection } from '../lib/utils'
import Anchor from './common/Anchor.astro'
import ThemeToggle from './ThemeToggle.astro'

const { data: config } = await getConfigurationCollection()
const { isHome } = Astro.props
---

<header class="zag-bg zag-border-b zag-transition sticky top-0 z-10 w-full">
    <div
        class="zag-bg zag-transition mx-auto flex max-w-2xl items-center justify-between"
    >
        <div
            class="zag-bg zag-transition relative z-50 flex items-center py-4 sm:hidden"
        >
            <button
                class="px-4"
                type="button"
                aria-label="Toggle navigation menu"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="32"
                    height="32"
                    viewBox="0 0 512 512"
                    class="zag-fill zag-transition"
                >
                    <title>Navigation menu</title>
                    <path
                        d="M80 96h352v32H80zm0 144h352v32H80zm0 144h352v32H80z"
                    ></path>
                </svg>
            </button>
        </div>
        <div class="zag-bg zag-transition flex basis-full">
            <div
                class="zag-bg zag-transition z-50 mt-0 h-16 py-4 pl-0 text-xl max-sm:basis-full sm:pl-4"
            >
                {
                    isHome ? (
                        ''
                    ) : (
                        <Anchor url="/" class="font-bold text-green-800">
                            {' '}
                            {config.personal.name}{' '}
                        </Anchor>
                    )
                }
            </div>
            <nav
                class="zag-bg zag-border-b zag-transition fixed inset-x-0 top-0 flex h-auto flex-col justify-between gap-8 py-4 text-xl sm:relative sm:flex-row sm:border-none sm:px-4 sm:pt-4"
            >
                <div
                    class="mt-16 flex flex-col gap-4 px-4 sm:mt-0 sm:flex-row sm:px-0"
                >
                    {
                        Object.entries(config.menu).map((i) => (
                            <Anchor
                                url={i[1]}
                                class="font-sans font-bold underline"
                            >
                                {i[0]}
                            </Anchor>
                        ))
                    }
                </div>
            </nav>
        </div>
        <div
            class="zag-bg zag-transition z-50 flex justify-between gap-4 px-4 py-4"
        >
            <ThemeToggle />
        </div>
    </div>
</header>

<script>
    const button = document.querySelector('button') as HTMLButtonElement
    const nav = document.querySelector('nav') as HTMLElement
    let isOpen = false

    function updateNavState() {
        const isMobile = window.matchMedia('(max-width: 640px)').matches
        if (isMobile) {
            nav.style.transform = isOpen ? 'translateY(0)' : 'translateY(-100%)'
        } else {
            nav.style.transform = 'translateY(0)'
            isOpen = false
        }
    }

    function toggleNav() {
        isOpen = !isOpen
        updateNavState()
    }

    button?.addEventListener('click', toggleNav)
    window.addEventListener('resize', updateNavState)

    updateNavState()
</script>
